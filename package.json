{
	"name": "modcrafting",
	"type": "module",
	"version": "1.0.1",
	"description": "A one-stop Minecraft mod development environment based on Vibecoding 基于Vibecoding的一站式Minecraft模组开发环境",
	"author": "newstarbar",
	"main": "./out/main/index.js",
	"scripts": {
		"dev": "pnpm run plugin:build && pnpm run view:start",
		"build": "pnpm run plugin:build && pnpm run bench:build && pnpm run migration:build",
		"preview": "pnpm run view:start",
		"start": "pnpm run view:start",
		"typecheck": "pnpm run plugin:typecheck && pnpm run view:typecheck",
		"verify:native": "node scripts/test/verify-native-deps.mjs",
		"test": "pnpm run plugin:test",
		"test:harness": "node scripts/test/run-harness.mjs",
		"test:mcp": "node --experimental-strip-types scripts/mcp/modcrafting-test-mcp.ts --self-test",
		"test:app": "node --experimental-strip-types scripts/test/run-app-automation.ts",
		"test:app:hidden": "node --experimental-strip-types scripts/test/run-app-automation.ts --hidden",
		"test:app:live": "node --experimental-strip-types scripts/test/run-app-automation.ts --live",
		"test:app:game": "node --experimental-strip-types scripts/test/run-app-automation.ts --game",
		"test:ui": "vitest run",
		"test:ui:update": "vitest run --update",
		"test:mcp:serve": "node --experimental-strip-types scripts/mcp/modcrafting-test-mcp.ts",
		"plugin:build": "node scripts/plugin/build.mjs",
		"view:start": "node plugins/modcrafting-fabric/dist/mcp-server.js --web-only",
		"view:typecheck": "tsc --noEmit --module esnext --moduleResolution bundler --target es2023 --jsx react-jsx --lib es2023,dom --allowImportingTsExtensions --esModuleInterop --skipLibCheck packages/modcrafting-view/src/main.tsx",
		"plugin:test": "node scripts/plugin/test.mjs",
		"bench:fabric": "node --experimental-strip-types scripts/bench/run-fabric-bench.ts",
		"bench:fabric:live": "node --experimental-strip-types scripts/bench/run-fabric-bench-live.ts",
		"bench:build": "node scripts/bench/build.mjs",
		"plugin:validate": "node scripts/plugin/validate.mjs",
		"plugin:qoder": "node scripts/plugin/stage-qoder.mjs",
		"plugin:stage": "node scripts/plugin/stage.mjs",
		"product:stage": "node scripts/plugin/stage-product.mjs",
		"host:config": "node scripts/plugin/host-config.mjs",
		"host:stage": "node scripts/plugin/stage-hosts.mjs",
		"host:smoke": "node scripts/plugin/smoke-hosts.mjs",
		"plugin:smoke": "node scripts/plugin/smoke.mjs",
		"plugin:typecheck": "tsc --noEmit --module nodenext --moduleResolution nodenext --target es2022 --allowImportingTsExtensions --esModuleInterop --skipLibCheck plugins/modcrafting-fabric/src/mcp-server.ts packages/modcrafting-core/src/index.ts scripts/bench/run-fabric-bench.ts scripts/bench/run-fabric-bench-live.ts scripts/plugin/migrate-desktop.ts",
		"bridge:build": "node scripts/bridge/build-observer.mjs",
		"build:win": "electron-vite build && node scripts/packaging/run-electron-builder.mjs --win nsis && node scripts/packaging/run-electron-builder.mjs --config electron-builder.portable.json --win portable && node scripts/packaging/verify-windows-artifacts.mjs",
		"build:win:setup": "electron-vite build && node scripts/packaging/run-electron-builder.mjs --win nsis && node scripts/packaging/verify-windows-artifacts.mjs --setup",
		"build:win:portable": "electron-vite build && node scripts/packaging/run-electron-builder.mjs --config electron-builder.portable.json --win portable && node scripts/packaging/verify-windows-artifacts.mjs --portable",
		"smoke:win": "node scripts/packaging/smoke-windows-app.mjs",
		"prebuild:win": "node scripts/prebuild-win.mjs --target full",
		"prebuild:win:setup": "node scripts/prebuild-win.mjs --target full",
		"prebuild:win:portable": "node scripts/prebuild-win.mjs --target portable",
		"toolchain:setup": "node scripts/toolchain/setup-toolchain.mjs",
		"toolchain:verify": "node scripts/toolchain/verify-toolchain.mjs",
		"toolchain:prefetch": "node scripts/toolchain/prefetch-fabric-deps.mjs",
		"toolchain:verify-offline": "node scripts/toolchain/verify-offline-build.mjs",
		"toolchain:symbol-index": "node scripts/toolchain/generate-fabric-symbol-index.mjs",
		"toolchain:export-zip": "node scripts/toolchain/export-runtime-zip.mjs",
		"assets:prepare": "python scripts/assets/prepare_renderer_assets.py",
		"assets:mc": "python scripts/assets/ensure_minecraft_assets.py",
		"assets:items": "python scripts/assets/generate_items.py",
		"assets:icon": "node scripts/assets/generate-icon-ico.mjs",
		"release:manifest": "node scripts/release/render-update-manifest.mjs",
		"release:notes": "node scripts/release/render-release-notes.mjs",
		"release:push-gitee": "node scripts/release/push-gitee-git.mjs",
		"release:sync-gitee": "node scripts/release/sync-gitee-release.mjs",
		"release:gitee-only": "node scripts/release/sync-gitee-only.mjs",
		"release:cleanup-github": "node scripts/release/cleanup-github-release.mjs",
		"clean:local": "node scripts/clean-local.mjs",
		"docs:sync-fabric": "node --experimental-strip-types scripts/sync-fabric-docs-knowledge.ts",
		"docs:prefetch-fabric": "pnpm run docs:sync-fabric",
		"setup:toolchain": "pnpm run toolchain:setup",
		"setup:worktree": "node scripts/setup-worktree.mjs",
		"prefetch:deps": "pnpm run toolchain:prefetch",
		"verify:toolchain": "pnpm run toolchain:verify",
		"verify:offline": "pnpm run toolchain:verify-offline",
		"generate:fabric-index": "pnpm run toolchain:symbol-index",
		"prepare:renderer-assets": "pnpm run assets:prepare",
		"prefetch:mc-assets": "pnpm run assets:mc",
		"generate:items": "pnpm run assets:items",
		"generate:icon": "pnpm run assets:icon",
		"render:manifest": "pnpm run release:manifest",
		"render:release-notes": "pnpm run release:notes",
		"sync:gitee": "pnpm run release:sync-gitee",
		"push:gitee": "pnpm run release:push-gitee",
		"postinstall": "node scripts/lib/ensure-native-deps.mjs",
		"knowledge:download": "node scripts/knowledge/download-knowledge-base.mjs",
		"knowledge:prefetch": "pnpm run knowledge:download",
		"desktop:dev": "electron-vite dev",
		"desktop:build": "electron-vite build",
		"desktop:start": "electron .",
		"desktop:preview": "electron-vite preview",
		"desktop:release:publish": "node scripts/release/publish-release.mjs",
		"migration:build": "node scripts/plugin/build-migration.mjs",
		"desktop:migrate": "node --experimental-strip-types scripts/plugin/migrate-desktop.ts",
		"desktop:setup": "pnpm run setup:worktree -- --desktop",
		"desktop:typecheck": "tsc --noEmit",
		"candidate:build": "node scripts/plugin/build-candidate.mjs",
		"acceptance:first-use": "node --experimental-strip-types scripts/acceptance/run-first-use.mjs"
	},
	"dependencies": {
		"@electron-toolkit/utils": "^4.0.0",
		"@fontsource/press-start-2p": "^5.2.7",
		"@xenova/transformers": "^2.17.2",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"ajv": "^8.20.0",
		"electron-updater": "^6.6.2",
		"iconv-lite": "^0.7.2",
		"node-pty": "^1.1.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"unzipper": "^0.12.3"
	},
	"packageManager": "pnpm@10.34.7",
	"pnpm": {
		"onlyBuiltDependencies": [
			"electron",
			"esbuild",
			"node-pty",
			"sharp"
		],
		"ignoredBuiltDependencies": [
			"electron-winstaller",
			"protobufjs"
		]
	},
	"devDependencies": {
		"@modelcontextprotocol/client": "2.0.0",
		"@modelcontextprotocol/node": "2.0.0",
		"@modelcontextprotocol/server": "2.0.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/react": "^19.1.2",
		"@types/react-dom": "^19.1.2",
		"@vitejs/plugin-react": "^6.0.2",
		"electron": "^42.4.1",
		"electron-builder": "26.17.0",
		"electron-vite": "^6.0.0-beta.1",
		"esbuild": "0.28.2",
		"jsdom": "^30.1.2",
		"png-to-ico": "^3.0.1",
		"sharp": "^0.35.2",
		"typescript": "^5.8.3",
		"vite": "^8.0.16",
		"vitest": "^3.2.7",
		"zod": "4.4.3"
	},
	"build": {
		"extends": "./electron-builder.base.json",
		"afterPack": "./scripts/packaging/afterpack-clean-runtime.mjs",
		"beforePack": "./scripts/packaging/patch-nsis-install-ui.mjs",
		"files": [
			"out/**/*",
			"!**/*.map",
			"!**/*.d.ts",
			"!**/*.md",
			"!**/test/**",
			"!**/tests/**",
			"!**/*.test.*",
			"!**/*development*.js",
			"!**/*profiling*.js",
			"!node_modules/react/**",
			"!node_modules/react-dom/**",
			"!node_modules/@xterm/**",
			"!node_modules/react-markdown/**",
			"!node_modules/remark-gfm/**",
			"!node_modules/@fontsource/**",
			"!node_modules/ajv/**",
			"!node_modules/protobufjs/**",
			"!node_modules/bare-*/**",
			"!node_modules/@huggingface/**",
			"!node_modules/onnx-proto/**",
			"!node_modules/flatbuffers/**",
			"!node_modules/long/**",
			"!node_modules/micromark*/**",
			"!node_modules/mdast-*/**",
			"!node_modules/remark-*/**",
			"!node_modules/unified/**",
			"!node_modules/vfile*/**",
			"!node_modules/hast*/**",
			"!node_modules/node-pty/node_modules/**",
			"!node_modules/node-pty/deps/**",
			"!node_modules/node-pty/third_party/**",
			"!node_modules/node-pty/src/**",
			"!node_modules/node-pty/scripts/**",
			"!node_modules/node-pty/typings/**",
			"!node_modules/node-pty/build/**",
			"!node_modules/node-pty/prebuilds/darwin-*/**",
			"!node_modules/node-pty/prebuilds/win32-arm64/**",
			"!node_modules/node-pty/**/*.pdb",
			"!node_modules/@xenova/**",
			"!node_modules/onnxruntime-node/**",
			"!node_modules/onnxruntime-web/**",
			"!node_modules/onnxruntime-common/**",
			"!node_modules/sharp/**",
			"!node_modules/@img/**"
		],
		"extraResources": [
			{
				"from": "resources/gradle-wrapper.jar",
				"to": "gradle-wrapper.jar"
			},
			{
				"from": "resources/fabric-versions.json",
				"to": "fabric-versions.json"
			},
			{
				"from": "resources/skills",
				"to": "skills"
			},
			{
				"from": "packaging/appIcon.png",
				"to": "icon.png"
			}
		],
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			],
			"icon": "packaging/appIcon.ico",
			"signExecutable": false
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"allowElevation": false,
			"perMachine": false,
			"createDesktopShortcut": false,
			"createStartMenuShortcut": false,
			"menuCategory": true,
			"shortcutName": "ModCrafting",
			"runAfterFinish": true,
			"deleteAppDataOnUninstall": false,
			"displayLanguageSelector": false,
			"language": "2052",
			"license": "packaging/license_zh_CN.txt",
			"installerSidebar": "packaging/installerSidebar.bmp",
			"installerHeader": "packaging/installerHeader.bmp",
			"uninstallerSidebar": "packaging/uninstallerSidebar.bmp",
			"include": "packaging/installer.nsh",
			"installerIcon": "packaging/installerIcon.ico",
			"installerHeaderIcon": "packaging/installerIcon.ico",
			"uninstallerIcon": "packaging/installerIcon.ico",
			"guid": "c8f4a2b1-9e3d-4f5a-b6c7-8d9e0f1a2b3c",
			"artifactName": "${productName}-Setup-${version}.${ext}",
			"uninstallDisplayName": "ModCrafting",
			"warningsAsErrors": false
		}
	},
	"publish": [
		{
			"provider": "github",
			"owner": "newstarbar",
			"repo": "ModCrafting",
			"draft": false,
			"releaseInfo": {
				"releaseNotesFile": "packaging/release-body.md"
			}
		}
	],
	"license": "GPL-3.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/newstarbar/ModCrafting.git"
	}
}
