{
  "suiteVersion": 1,
  "id": "fabric-bench-live-mvp",
  "execution": "live",
  "cases": [
    {
      "id": "inventory_pass",
      "prepare": [
        "give @s minecraft:stone 1"
      ],
      "spec": {
        "version": 2,
        "id": "p2_inventory_pass",
        "featureType": "player_interaction",
        "subject": {},
        "setup": [
          {
            "type": "command",
            "command": "clear @s minecraft:stone"
          }
        ],
        "actions": [
          {
            "type": "command",
            "command": "give @s minecraft:stone 1"
          },
          {
            "type": "wait",
            "ms": 300
          }
        ],
        "assertions": [
          {
            "type": "inventory_contains",
            "itemId": "minecraft:stone",
            "countAtLeast": 1
          }
        ],
        "cleanup": [
          {
            "type": "command",
            "command": "clear @s minecraft:stone"
          }
        ]
      },
      "expected": {
        "verdict": "PASS",
        "code": "OK"
      }
    },
